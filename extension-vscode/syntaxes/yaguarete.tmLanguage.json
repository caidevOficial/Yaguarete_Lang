{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "YAGUARETÉ Pseudocode",
  "scopeName": "source.yaguarete",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#struct_definition" },
    { "include": "#function_definition" },
    { "include": "#control_flow" },
    { "include": "#storage_types" },
    { "include": "#custom_types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#properties" },
    { "include": "#function_calls" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.triple-quote.yaguarete",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "comment.block.c-style.yaguarete",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.number-sign.yaguarete",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.yaguarete",
          "match": "(^\\s*//.*$|(?<=[;:,])\\s*//.*$|//\\s*[-=*#/!~].*$|//\\s*$|//\\s+.*$)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.yaguarete",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.yaguarete",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.yaguarete",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.yaguarete",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "struct_definition": {
      "patterns": [
        {
          "match": "(?i)\\b(ESTRUCTURA)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.struct.yaguarete" },
            "2": { "name": "entity.name.type.struct.yaguarete" }
          }
        }
      ]
    },
    "function_definition": {
      "patterns": [
        {
          "match": "(?i)\\b(FUNCION|PROCEDIMIENTO)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.yaguarete" },
            "2": { "name": "entity.name.function.yaguarete" }
          }
        }
      ]
    },
    "control_flow": {
      "patterns": [
        {
          "name": "keyword.control.structure.yaguarete",
          "match": "(?i)\\b(ALGORITMO|PROGRAMA|INICIO|ESTRUCTURA|FIN(\\s+(SI|MIENTRAS|PARA|FUNCION|PROCEDIMIENTO|ESTRUCTURA))?)\\b"
        },
        {
          "name": "keyword.control.flow.return.yaguarete",
          "match": "(?i)\\b(RETORNAR|RETORNO)\\b"
        },
        {
          "name": "keyword.control.conditional.yaguarete",
          "match": "(?i)\\b(SI|ENTONCES|SINO(\\s+SI)?)\\b"
        },
        {
          "name": "keyword.control.repeat.yaguarete",
          "match": "(?i)\\b(MIENTRAS|PARA|HASTA|PASO|HACER)\\b"
        },
        {
          "name": "keyword.operator.logical.yaguarete",
          "match": "(?i)\\b(Y|O|NO)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.yaguarete",
          "match": "(?i)\\b(MOD|ESPAR|ESIMPAR)\\b"
        }
      ]
    },
    "storage_types": {
      "patterns": [
        {
          "name": "storage.type.primitive.yaguarete",
          "match": "(?i)\\b(ENTERO|FLOTANTE|REAL|CADENA|CARACTER|BOOLEANO|ARCHIVO|VACIO|SIN_RETORNO|NULO)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.null.yaguarete",
          "match": "(?i)\\b(NULO|NULL|NONE)\\b"
        },
        {
          "name": "constant.language.boolean.yaguarete",
          "match": "(?i)\\b(VERDADERO|FALSO|TRUE|FALSE)\\b"
        },
        {
          "name": "constant.numeric.float.yaguarete",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.yaguarete",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.io.yaguarete",
          "match": "(?i)\\b(MOSTRAR|LEER|IMPRIMIR)\\b"
        },
        {
          "name": "support.function.builtin.file.yaguarete",
          "match": "(?i)\\b(ABRIR_ARCHIVO|CERRAR_ARCHIVO|LEER_LINEA|ESCRIBIR_LINEA)\\b"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.separator.period.yaguarete" },
            "2": { "name": "variable.other.property.yaguarete" }
          }
        }
      ]
    },
    "function_calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.yaguarete" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.yaguarete",
          "match": "(<-|:=)"
        },
        {
          "name": "keyword.operator.comparison.yaguarete",
          "match": "(==|!=|<>|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.simple.yaguarete",
          "match": "="
        },
        {
          "name": "keyword.operator.increment-decrement.yaguarete",
          "match": "(\\+\\+|--)"
        },
        {
          "name": "keyword.operator.arithmetic.yaguarete",
          "match": "(//|\\+|-|\\*|/|%|\\^)"
        },
        {
          "name": "punctuation.delimiter.yaguarete",
          "match": "(\\,|\\;|\\:)"
        },
        {
          "name": "punctuation.bracket.yaguarete",
          "match": "(\\[|\\]|\\(|\\)|\\{|\\})"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.yaguarete",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "custom_types": {
      "patterns": [
        {
          "match": "(:)\\s*(?!(?i:ENTERO|FLOTANTE|REAL|CADENA|CARACTER|BOOLEANO|ARCHIVO|VACIO|SIN_RETORNO|NULO|NULL|NONE|VERDADERO|FALSO|TRUE|FALSE)\\b)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.delimiter.yaguarete" },
            "2": { "name": "entity.name.type.struct.yaguarete" }
          }
        },
        {
          "match": "(?!(?i:ENTERO|FLOTANTE|REAL|CADENA|CARACTER|BOOLEANO|ARCHIVO|VACIO|SIN_RETORNO|NULO|NULL|NONE|VERDADERO|FALSO|TRUE|FALSE|ALGORITMO|PROGRAMA|INICIO|ESTRUCTURA|FIN|RETORNAR|RETORNO|SI|ENTONCES|SINO|MIENTRAS|PARA|HASTA|PASO|HACER|Y|O|NO|MOD|ESPAR|ESIMPAR|FUNCION|PROCEDIMIENTO|MOSTRAR|LEER|IMPRIMIR)\\b)\\b([A-Z][a-zA-Z0-9_]*)(?=(?:\\s*\\[\\s*\\d*\\s*\\])*\\s+[a-zA-Z_][a-zA-Z0-9_]*\\b)",
          "captures": {
            "1": { "name": "entity.name.type.struct.yaguarete" }
          }
        }
      ]
    }
  }
}
